# Copy to .env. Never paste secrets into chat. Restart after edits.
OPENAI_API_KEY=
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_TECHNICAL_MODEL=gpt-6-luna
OPENAI_MANAGER_MODEL=gpt-5.4-mini
# USD per million tokens, official model page checked 2026-10-20.
OPENAI_INPUT_USD_PER_MILLION=2
OPENAI_OUTPUT_USD_PER_MILLION=10
MONTHLY_BUDGET_EUR=30
# Cost accounting remains active. No local spending cap unless explicitly enabled.
API_SPEND_LIMIT_ENABLED=false
ALPACA_FEED=iex
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD
SEC_USER_AGENT=
# Local-only. Remote access requires a separately configured HTTPS tunnel/VPN.
HOST=127.0.0.1
PORT=8765
# Optional private remote console. Secret key stays on this PC; never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_SECONDS=60
